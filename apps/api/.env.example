# Copy to .env and fill in. .env is git-ignored; never commit real tokens.
# Every limit (timeouts, sizes, rates) has a safe default in app/config.py and a
# GRAVECAST_* override there; only the common settings are listed here.

# Optional GitHub token for the repo graveyard: raises GitHub's rate limit.
# A fine-grained token with read-only access to public repositories is enough.
GITHUB_TOKEN=

# Which websites may call the API from a browser, comma-separated.
# Add the deployed site's address, e.g. https://your-app.vercel.app
GRAVECAST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where Chat's echoes are stored during development (SQLite).
# GRAVECAST_CHANNEL_DB_PATH=../../storage/channel.sqlite3

# Where cloned repositories are kept while they are read.
# GRAVECAST_WORKSPACE_ROOT=../../storage/repositories
