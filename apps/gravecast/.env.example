# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.
# Every VITE_ value is built into the page, so anyone can read it. Only put browser-safe values here.

# Gravecast API (link scan, repo graveyard, Chat mail runs).
# Leave empty in development: Vite forwards /api to http://localhost:8000
# (set GRAVECAST_API to point the dev proxy somewhere else).
# When deployed, the API's public address with no trailing slash, e.g. a Lambda Function URL.
VITE_API_URL=

# Help near you: Amazon Location Service (Places SearchNearby), called from the phone.
# Use a browser API key limited in the AWS console to geo-places:SearchNearby,
# to this site's addresses (referers), and with an expiry date.
# Without both values, Help near you says finding places isn't set up yet.
VITE_AWS_LOCATION_KEY=
# The key's region, e.g. us-east-1.
VITE_AWS_LOCATION_REGION=
