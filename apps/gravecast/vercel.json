{
  "headers": [
    { "source": "/emergency/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/emergency/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "rewrites": [
    { "source": "/emergency/:path*", "destination": "/emergency/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}