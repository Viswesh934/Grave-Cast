{
  "installCommand": "npm ci --prefix ../../packages/grave-ui && npm ci",
  "buildCommand": "npm run build --prefix ../../packages/grave-ui && npm run build",
  "headers": [
    { "source": "/lantern/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/lantern/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/emergency/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "redirects": [
    { "source": "/emergency", "destination": "/lantern/", "permanent": false },
    { "source": "/emergency/:path((?!sw\\.js$).*)", "destination": "/lantern/:path", "permanent": false }
  ],
  "rewrites": [
    { "source": "/lantern/:path*", "destination": "/lantern/index.html" },
    { "source": "/:path((?!api/).*)", "destination": "/index.html" }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://t5hjk3xhvbtlwr35mrpfr6q3hy0xrqxa.lambda-url.ap-south-1.on.aws/api/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-origin-secret" },
          "args": "$ORIGIN_SECRET",
          "env": ["ORIGIN_SECRET"]
        }
      ]
    }
  ]
}
